{
  "name": "coop-bullet-hell-roguelike",
  "version": "0.1.0",
  "private": true,
  "description": "Online co-op roguelike platforming bullet hell. TypeScript + HTML5 Canvas client, Node + ws authoritative server, deterministic shared simulation core.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "start": "node dist/server/index.js",
    "test": "tsc --noEmit && node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
